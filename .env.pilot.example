# Kopiera till .env.pilot.local för operatörskommandon. Aldrig produktionsnycklar.
# Använd dev-deploymentens riktiga namn i samtliga tre fält.
PILOT_CONVEX_DEPLOYMENT=dev:replace-with-dev-name
NEXT_PUBLIC_CONVEX_URL=https://replace-with-dev-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://replace-with-dev-name.convex.site
PILOT_APP_ORIGIN=https://replace-with-stable-preview.vercel.app

# Endast lokalt för backendoperatören. Lägg INTE denna nyckel i Vercel.
CONVEX_DEPLOY_KEY=
